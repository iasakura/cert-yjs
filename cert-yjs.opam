opam-version: "2.0"
license: "MIT"
maintainer: "iasakura"
authors: "iasakura"
homepage: "https://github.com/iasakura/cert-yjs"
bug-reports: "https://github.com/iasakura/cert-yjs/issues"
dev-repo: "git+https://github.com/iasakura/cert-yjs.git"
version: "dev"
synopsis: "Verified Yjs-style CRDT in Go, proved with Perennial"

depends: [
  "perennial"
  "rocq-yjs"
]

pin-depends: [
  # Fork of mit-pdos/perennial: upstream f884a505d plus one goose-only patch
  # (an ffiMapping entry routing the grovenet package to the grove FFI, #45).
  # The patch touches no .v file, so the Perennial Rocq library this builds is
  # identical to upstream's; goose's --local build picks up the mapping from the
  # same commit (see .github/workflows/ci.yml). Drop the fork once the mapping
  # is upstreamed.
  ["perennial.dev"             "git+https://github.com/iasakura/perennial#e8af799716f3b8963a61975b9e6652f1192f49cb"]
  ["rocq-yjs.dev"              "git+https://github.com/iasakura/iris-yjs#2947b30f0ab6e74cf1f3e2d98ed2b227c17f79ee"]
  ["rocq-yjs-core.dev"         "git+https://github.com/iasakura/iris-yjs#2947b30f0ab6e74cf1f3e2d98ed2b227c17f79ee"]

  ## begin indirect
  ["coq-coqutil.dev"           "git+https://github.com/mit-plv/coqutil#cfd88cef005cda5ec400108606d27a0d40578a8f"]
  ["coq-record-update.dev"     "git+https://github.com/tchajed/coq-record-update#7b2645210331c3ec4ed75fa5ad0840a723f25151"]
  ["iris-named-props.dev"      "git+https://github.com/tchajed/iris-named-props#ca663d2709888a789a03edc861b7bde86ddd56e5"]
  ["rocq-iris.dev"             "git+https://gitlab.mpi-sws.org/iris/iris#1e6e3a57d8ad52b880633cc69c979ff7e65d6fbc"]
  ["rocq-stdpp.dev"            "git+https://gitlab.mpi-sws.org/iris/stdpp#6151984a1e2770649858f9d578023ffc1b337421"]
  ## end
]

build: [make "-j%{jobs}%"]
install: ["go" "tool" "perennial-cli" "install"]
build-env: [
  [GOCACHE = "%{build}%/_build/.gocache"]
]
